# AgriScope Environment Configuration
# Copy to .env and adjust values for your local setup

# Application
APP_NAME=AgriScope
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
FRONTEND_PORT=5173

# Hadoop / HDFS
HADOOP_HOME=/opt/homebrew/opt/hadoop/libexec
HDFS_URI=hdfs://localhost:9000
HDFS_BASE_PATH=/agriscope

# Spark
SPARK_HOME=
SPARK_MASTER=local[*]

# Java
JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home

# Database (SQLite for metadata)
DATABASE_URL=sqlite:///./agriscope.db

# CORS
CORS_ORIGINS=http://localhost:5173

# Upload limits
MAX_UPLOAD_SIZE_MB=500
ALLOWED_UPLOAD_EXTENSIONS=.csv,.tsv,.json

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
